import { questionEntry } from "@wix/faq";

export async function listQuestionEntries(options) {
    const response = await questionEntry.listQuestionEntries(options);
    console.log("res", response);
}


export async function getPlainTextQuestionsByCategory(categoryId) {
  const options = {
    categoryId: categoryId, 
    contentFormat: 'PLAIN_TEXT' 
  };

  try {
    const response = await questionEntry.listQuestionEntries(options);
    return response.questionEntries;
  } catch (error) {
    console.error("Error fetching question entries:", error);
  }
}


import { extendedBookings } from '@wix/bookings';

export async function getBookingDetails(bookingId) {
  const query = {
    filter: {
      _id: bookingId
    }
  };

  const options = {
    withBookingAttendanceInfo: true,
    withBookingConferencingDetails: true
  };

  try {
    const response = await extendedBookings.queryExtendedBookings(query, options);
    return response.extendedBookings;
  } catch (error) {
    console.error("Error querying extended bookings:", error);
  }
}
