{
  "jobs": [
    {
      "functionLocation": "/jobs.js",
      "functionName": "expireStuckUpgradePayments",
      "description": "Hourly: clear upgrade flags stuck in pending-payment-approval (>1h). canvasSize stays 60x60 until paid.",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/jobs.js",
      "functionName": "reconcileStuckWorkshopOrders",
      "description": "Hourly: safety net for WorkshopOrders stuck pending/checkout_created (>20min) — re-checks eCom by checkoutId and reconciles paid/abandoned. (Wix jobs minimum interval is 1h.)",
      "executionConfig": {
        "cronExpression": "30 * * * *"
      }
    },
