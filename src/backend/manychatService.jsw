/**
 * manychatService.jsw — ManyChat integration for the "אישור הזמנה" flow.
 *
 * LIVE FOR ALL ORDERS: ManyChat approved the import permission, so every
 * paid order now goes through this module (see data.js) — no more
 * test-phone gate / Green API fallback for order confirmations.
 *
 * EMPLOYEE_MANYCHAT_ALLOWED_PHONES below is unrelated to orders — it's
 * reserved for the future employee/manager notifications ManyChat flow
 * (not built yet), restricted to the owner's own number for testing.
 *
 * Never throws out of sendOrderConfirmationManyChat — a ManyChat failure
 * must never block order creation/payment. All errors are caught and logged.
 */
import wixSecretsBackend from 'wix-secrets-backend';
import { fetch } from 'wix-fetch';
import { normalizeIsraeliPhone } from 'backend/orderUtils.js';

const MANYCHAT_BASE_URL = 'https://api.manychat.com';
const ISRAEL_TZ = 'Asia/Jerusalem';

// Custom field names — must match ManyChat (see create-manychat-fields.js).
export const MC_FIELDS = {
    workshopType: 'workshop_type',
    organizerName: 'organizer_name',
    organizerPhone: 'organizer_phone',
    organizerEmail: 'organizer_email',
    workshopName: 'workshop_name',
    workshopDate: 'workshop_date',
    workshopTime: 'workshop_time',
    participantsLine: 'participants_line',
    itemCount: 'item_count',
    cupsCount: 'cups_count',
    extraItems: 'extra_items',
    amount: 'amount',
    orderUrl: 'order_url',
    orderNumber: 'order_number',
};

// Custom field created manually in ManyChat (Settings > Custom Fields, type "Text")
// used by the flow's conditions to branch per workshop. Values mirror the
// existing `workshopType` values already used across the codebase.
export const WORKSHOP_CUSTOM_FIELD_NAME = MC_FIELDS.workshopType;

// content20260826091942_789880 — shared "אישור הזמנה" flow, branches
// internally per WORKSHOP_CUSTOM_FIELD_NAME condition.
const ORDER_CONFIRMATION_FLOW_NS = 'content20260826091942_789880';

// Shared employee/manager notification flow — branches internally by action_key.
const STAFF_NOTIFICATION_FLOW_NS = 'content20260826132939_659401';

// Custom fields used by the staff/manager flow's routing conditions.
const STAFF_ACTION_KEY_FIELD = 'action_key';
const STAFF_AUDIENCE_FIELD = 'staff_audience';

// TEST MODE allowlist for the future employee/manager ManyChat system
// (schedulingEngine / shiftConfirmations / shiftSwaps notifications).
// NOT used for order confirmations anymore — those are now open to all
// customers. Only the owner's own number is allowed while that system is
// being built and tested.
const EMPLOYEE_MANYCHAT_ALLOWED_PHONES = new Set([
    normalizeIsraeliPhone('0523813929'),
]);

/** Gate for the (not-yet-built) employee/manager ManyChat flow — owner-only for now. */
export function isEmployeeManyChatAllowedPhone(phone) {
    const normalized = normalizeIsraeliPhone(phone);
    return !!normalized && EMPLOYEE_MANYCHAT_ALLOWED_PHONES.has(normalized);
}

async function getManyChatApiKey() {
    const apiKey = await wixSecretsBackend.getSecret('manychat_apiKey');
    if (!apiKey) {
        throw new Error('[ManyChat] Missing "manychat_apiKey" in Wix Secrets Manager');
    }
    return apiKey;
}

async function manychatRequest(path, { method = 'GET', query, body } = {}) {
    const apiKey = await getManyChatApiKey();

    let url = `${MANYCHAT_BASE_URL}${path}`;
    if (query) {
        const qs = new URLSearchParams(
            Object.entries(query).filter(([, v]) => v !== undefined && v !== null && v !== '')
        ).toString();
        if (qs) url += `?${qs}`;
    }

    const response = await fetch(url, {
        method,
        headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${apiKey}`,
        },
        body: body ? JSON.stringify(body) : undefined,
    });

    const json = await response.json().catch(() => null);

    if (!response.ok || json?.status === 'error') {
        const detail = json ? JSON.stringify(json) : await response.text().catch(() => '');
        throw new Error(`[ManyChat] ${method} ${path} failed (${response.status}): ${detail}`);
    }

    return json;
}

// --- Subscriber lookup / creation ---

/** ManyChat often stores phone as 972XXXXXXXXX (no +). Try that first. */
function getManyChatPhoneLookupVariants(phone) {
    const e164 = normalizeIsraeliPhone(phone); // +972523813929
    if (!e164) return [];

    const digits = e164.replace(/\D/g, ''); // 972523813929
    const local = digits.startsWith('972') ? '0' + digits.slice(3) : ''; // 0523813929

    return [...new Set([digits, e164, local].filter(Boolean))];
}

/** Canonical format for createSubscriber — digits only, no leading +. */
function formatPhoneForManyChat(phone) {
    const e164 = normalizeIsraeliPhone(phone);
    return e164 ? e164.replace(/^\+/, '') : '';
}

/** GET /fb/subscriber/findBySystemField — query params only, one field at a time. */
async function findSubscriberByField(field, value) {
    if (!value) return null;
    const json = await manychatRequest('/fb/subscriber/findBySystemField', {
        method: 'GET',
        query: { [field]: value },
    });
    // ManyChat returns data: {} (single object) when found, or an empty
    // array/object when nothing matches.
    const data = json?.data;
    if (!data || Array.isArray(data) && data.length === 0) return null;
    if (Array.isArray(data)) return data[0] || null;
    return data.id ? data : null;
}

/**
 * Looks up an existing subscriber by email first (most reliable), then by
 * phone using multiple format variants (972..., +972..., 05...).
 * WhatsApp-only subscribers may still not be found via phone — email is
 * tried first for that reason.
 */
async function findSubscriber({ email, phone }) {
    if (email) {
        const byEmail = await findSubscriberByField('email', email);
        if (byEmail) return byEmail;
    }
    if (phone) {
        const variants = getManyChatPhoneLookupVariants(phone);
        for (const variant of variants) {
            console.log('[ManyChat] findBySystemField phone try:', variant);
            const byPhone = await findSubscriberByField('phone', variant);
            if (byPhone) {
                console.log('[ManyChat] Subscriber found via phone format:', variant);
                return byPhone;
            }
        }
    }
    return null;
}

function splitName(fullName) {
    const trimmed = String(fullName || '').trim();
    if (!trimmed) return { firstName: '', lastName: '' };
    const parts = trimmed.split(/\s+/);
    return {
        firstName: parts[0],
        lastName: parts.slice(1).join(' ') || '',
    };
}

/** POST /fb/subscriber/createSubscriber */
async function createSubscriber({ firstName, lastName, phone, email }) {
    const mcPhone = formatPhoneForManyChat(phone);
    const json = await manychatRequest('/fb/subscriber/createSubscriber', {
        method: 'POST',
        body: {
            first_name: firstName || undefined,
            last_name: lastName || undefined,
            phone: mcPhone || undefined,
            whatsapp_phone: mcPhone || undefined,
            email: email || undefined,
            has_opt_in_sms: !!mcPhone,
            has_opt_in_email: !!email,
            consent_phrase: 'אישור הזמנת סדנה באתר Studio Happy',
        },
    });
    return json?.data || null;
}

/** POST /fb/subscriber/setCustomFieldByName */
async function setCustomFieldByName(subscriberId, fieldName, fieldValue) {
    return manychatRequest('/fb/subscriber/setCustomFieldByName', {
        method: 'POST',
        body: {
            subscriber_id: subscriberId,
            field_name: fieldName,
            field_value: fieldValue,
        },
    });
}

/** POST /fb/subscriber/setCustomFields — batch update by field_name */
function hasManyChatFieldValue(value) {
    if (value === null || value === undefined) return false;
    if (typeof value === 'string' && value.trim() === '') return false;
    return true;
}

function toManyChatFieldValue(value) {
    // All order-confirmation fields are Text type in ManyChat — must be strings.
    return String(value);
}

async function setCustomFieldsByName(subscriberId, fields) {
    const payload = fields
        .filter(({ name, value }) => !!name && hasManyChatFieldValue(value))
        .map(({ name, value }) => ({
            field_name: name,
            field_value: toManyChatFieldValue(value),
        }));

    if (!payload.length) return;

    try {
        await manychatRequest('/fb/subscriber/setCustomFields', {
            method: 'POST',
            body: {
                subscriber_id: subscriberId,
                fields: payload,
            },
        });
    } catch (err) {
        console.warn('[ManyChat] setCustomFields batch failed, falling back to individual:', err?.message || err);
        for (const { field_name, field_value } of payload) {
            try {
                await setCustomFieldByName(subscriberId, field_name, field_value);
            } catch (fieldErr) {
                console.warn(`[ManyChat] setCustomFieldByName failed for "${field_name}":`, fieldErr?.message || fieldErr);
            }
        }
    }
}

function formatWorkshopDate(dateObj) {
    if (!dateObj) return '';
    const d = new Date(dateObj);
    const parts = new Intl.DateTimeFormat('he-IL', {
        timeZone: ISRAEL_TZ,
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
    }).formatToParts(d);
    const get = (t) => parts.find(p => p.type === t)?.value || '';
    return `${get('weekday')}, ${get('day')} ${get('month')} ${get('year')} בשעה ${get('hour')}:${get('minute')}`;
}

function formatWorkshopTime(dateObj) {
    if (!dateObj) return '';
    const d = new Date(dateObj);
    const parts = new Intl.DateTimeFormat('he-IL', {
        timeZone: ISRAEL_TZ,
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
    }).formatToParts(d);
    const get = (t) => parts.find(p => p.type === t)?.value || '';
    return `${get('hour')}:${get('minute')}`;
}

function workshopTypeLabel(workshopType) {
    if (workshopType === 'candles') return 'סדנת נרות';
    if (workshopType === 'ceramics') return 'סדנת קרמיקה';
    return 'טאפטינג';
}

function buildParticipantsLine(order, workshopType) {
    const adults = order?.adults || 0;
    const children = order?.children || 0;
    if (workshopType === 'ceramics') return String(adults + children);
    return `${adults} מבוגרים${children > 0 ? ` + ${children} ילדים` : ''}`;
}

function buildOrderCustomFields(order) {
    const workshopType = order?.workshopType || 'tufting';
    const total = order?.paidTotal || order?.basePrice || 0;
    const cupsCount = Array.isArray(order?.selectedProducts)
        ? order.selectedProducts.reduce((sum, p) => sum + (Number(p.quantity) || 1), 0)
        : 0;
    const extraItems = order?.extraCandleCount || 0;

    const fields = [
        { name: MC_FIELDS.workshopType, value: workshopType },
        { name: MC_FIELDS.organizerName, value: order?.organizerName },
        { name: MC_FIELDS.organizerPhone, value: order?.organizerPhone },
        { name: MC_FIELDS.organizerEmail, value: order?.organizerEmail },
        { name: MC_FIELDS.workshopName, value: workshopTypeLabel(workshopType) },
        { name: MC_FIELDS.workshopDate, value: formatWorkshopDate(order?.workshopStart) },
        { name: MC_FIELDS.workshopTime, value: formatWorkshopTime(order?.workshopStart) },
        { name: MC_FIELDS.participantsLine, value: buildParticipantsLine(order, workshopType) },
        { name: MC_FIELDS.itemCount, value: order?.rugCount ?? 0 },
        { name: MC_FIELDS.amount, value: total },
    ];

    if (order?.ecomOrderNumber) {
        fields.push({ name: MC_FIELDS.orderNumber, value: order.ecomOrderNumber });
    }

    // The ManyChat template already contains the full base URL
    // (https://www.studiohappy.art/user-selections?admin=) — only the
    // dynamic order id goes into the field, or it gets double-prefixed.
    if (workshopType === 'tufting' && order?._id) {
        fields.push({ name: MC_FIELDS.orderUrl, value: order._id });
    }

    if (workshopType === 'candles' && cupsCount > 0) {
        fields.push({ name: MC_FIELDS.cupsCount, value: cupsCount });
    }

    if (workshopType === 'ceramics' && extraItems > 0) {
        fields.push({ name: MC_FIELDS.extraItems, value: extraItems });
    }

    return fields;
}

async function setOrderCustomFields(subscriberId, order) {
    const fields = buildOrderCustomFields(order);
    const sending = fields.filter(f => hasManyChatFieldValue(f.value));
    console.log('[ManyChat] setCustomFields:', sending.map(f => `${f.name}=${f.value}`).join(', '));
    await setCustomFieldsByName(subscriberId, fields);
}

/** POST /fb/sending/sendFlow */
async function sendFlow(subscriberId, flowNs) {
    return manychatRequest('/fb/sending/sendFlow', {
        method: 'POST',
        body: {
            subscriber_id: subscriberId,
            flow_ns: flowNs,
        },
    });
}

// --- Order confirmation entry point ---

/**
 * Finds-or-creates the ManyChat subscriber for this order's organizer, sets
 * the workshop-routing custom field, and sends the "אישור הזמנה" flow.
 * Throws on failure — used internally by both the production hook (which
 * catches) and the sandbox test helper below (which wants the real error).
 */
async function runOrderConfirmationManyChat(order, { allowCreate = true } = {}) {
    const phone = normalizeIsraeliPhone(order?.organizerPhone);
    const email = order?.organizerEmail || '';
    const workshopType = order?.workshopType || 'tufting';

    if (!phone) {
        throw new Error('[ManyChat] Skipping — no organizerPhone on order');
    }

    let subscriber = await findSubscriber({ email, phone });

    if (!subscriber && allowCreate) {
        const { firstName, lastName } = splitName(order?.organizerName);
        console.log('[ManyChat] Subscriber not found, creating. orderId:', order?._id, 'phone:', phone);
        subscriber = await createSubscriber({ firstName, lastName, phone, email });
    } else if (!subscriber) {
        // allowCreate=false (sandbox test with ManyChat import permission not
        // yet approved) — don't hit createSubscriber, fail with a clear hint.
        const tried = getManyChatPhoneLookupVariants(order?.organizerPhone).join(', ') || phone;
        throw new Error(`[ManyChat] No subscriber found for phone variants tried: [${tried}] email=${email || '(none)'}. Create the contact manually in ManyChat first (createSubscriber is skipped), then re-run.`);
    } else {
        console.log('[ManyChat] Subscriber found. orderId:', order?._id, 'subscriberId:', subscriber.id);
    }

    if (!subscriber?.id) {
        throw new Error('[ManyChat] No subscriber id after find/create');
    }

    await setOrderCustomFields(subscriber.id, order);
    await sendFlow(subscriber.id, ORDER_CONFIRMATION_FLOW_NS);

    console.log('[ManyChat] Flow sent. orderId:', order?._id, 'subscriberId:', subscriber.id, 'workshopType:', workshopType);
    return { subscriberId: subscriber.id, workshopType };
}

/**
 * Production entry point — called from data.js on every paid order.
 * Never throws — a ManyChat failure must never block the order.
 */
export async function sendOrderConfirmationManyChat(order) {
    try {
        await runOrderConfirmationManyChat(order, { allowCreate: true });
    } catch (err) {
        console.error('[ManyChat] sendOrderConfirmationManyChat failed. orderId:', order?._id, 'error:', err?.message || err);
    }
}

// --- Employee/manager notification flow ---

/** displayName → display_name, hoursWindow → hours_window (matches create-manychat-fields.js). */
function camelToSnake(key) {
    return String(key).replace(/([a-z0-9])([A-Z])/g, '$1_$2').toLowerCase();
}

function buildStaffCustomFields(actionKey, audience, vars) {
    const fields = [
        { name: STAFF_ACTION_KEY_FIELD, value: actionKey },
        { name: STAFF_AUDIENCE_FIELD, value: audience },
    ];
    for (const [key, value] of Object.entries(vars || {})) {
        fields.push({ name: camelToSnake(key), value });
    }
    return fields;
}

/**
 * Sends one employee/manager notification via ManyChat. Mirrors
 * runOrderConfirmationManyChat: find-or-create subscriber by phone, set
 * action_key + staff_audience + every var as a custom field, then send the
 * shared staff-notification flow (branches internally by action_key).
 *
 * TEST MODE: only isEmployeeManyChatAllowedPhone() numbers actually send —
 * every other recipient is skipped (logged, not an error) until the
 * employee/manager rollout opens up. Never throws — same contract as
 * sendOrderConfirmationManyChat.
 *
 * @param {string} actionKey - matches EMPLOYEE_ACTION_KEYS in employeeTemplates.js.
 * @param {string} phone
 * @param {'employee'|'manager'} audience
 * @param {object} [vars] - camelCase placeholder vars (e.g. { displayName, date, portalLink }).
 */
export async function sendStaffManyChat(actionKey, phone, audience, vars = {}) {
    if (!isEmployeeManyChatAllowedPhone(phone)) {
        console.log(`[ManyChat staff] TEST MODE — skipping actionKey=${actionKey} phone=${phone} (not allowlisted)`);
        return { sent: false, reason: 'not-allowlisted' };
    }

    try {
        const normalizedPhone = normalizeIsraeliPhone(phone);
        if (!normalizedPhone) {
            console.warn(`[ManyChat staff] no valid phone for actionKey=${actionKey}`);
            return { sent: false, reason: 'no-phone' };
        }

        let subscriber = await findSubscriber({ phone: normalizedPhone });
        if (!subscriber) {
            subscriber = await createSubscriber({ phone: normalizedPhone });
        }
        if (!subscriber?.id) {
            throw new Error('No subscriber id after find/create');
        }

        const fields = buildStaffCustomFields(actionKey, audience, vars);
        console.log('[ManyChat staff] setCustomFields:', fields.filter(f => hasManyChatFieldValue(f.value)).map(f => `${f.name}=${f.value}`).join(', '));
        await setCustomFieldsByName(subscriber.id, fields);
        await sendFlow(subscriber.id, STAFF_NOTIFICATION_FLOW_NS);

        console.log(`[ManyChat staff] Flow sent. actionKey=${actionKey} subscriberId=${subscriber.id}`);
        return { sent: true, subscriberId: subscriber.id };
    } catch (err) {
        console.error(`[ManyChat staff] sendStaffManyChat failed. actionKey=${actionKey}:`, err?.message || err);
        return { sent: false, reason: 'error', error: err?.message || String(err) };
    }
}

// --- Sandbox test helpers ---
//
// Run ▶ directly from the Velo Editor (no real order needed):
//   testManyChatFlowTufting()   — אישור הזמנה לטאפטינג
//   testManyChatFlowCandles()   — אישור הזמנה לסדנת נרות
//   testManyChatFlowCeramics()  — אישור הזמנה לסדנת קרמיקה
//
// Or testManyChatFlow({ "workshopType": "candles", ... }) for custom overrides.
// ManyChat import permission is approved, so createSubscriber is tested by
// default (_allowCreate: true). Pass { "_allowCreate": false } to only
// exercise the find path against an already-existing contact.

function buildMockOrderForWorkshop(workshopType) {
    const workshopStart = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString();
    const base = {
        _id: `sandbox-test-${workshopType}-${Date.now()}`,
        organizerName: 'בדיקת מנצ׳אט',
        organizerPhone: '0523813929',
        organizerEmail: 'test@studiohappy.art',
        workshopType,
        workshopStart,
        adults: 2,
        basePrice: 450,
        paidTotal: 450,
    };

    if (workshopType === 'candles') {
        return {
            ...base,
            children: 1,
            rugCount: 4,
            selectedProducts: [{ quantity: 2 }, { quantity: 1 }],
        };
    }

    if (workshopType === 'ceramics') {
        return {
            ...base,
            children: 0,
            rugCount: 2,
            extraCandleCount: 1,
        };
    }

    // tufting (default)
    return {
        ...base,
        children: 1,
        rugCount: 3,
    };
}

export async function testManyChatFlow(overrides) {
    const safeOverrides = overrides && typeof overrides === 'object' ? overrides : {};
    const { _allowCreate = true, _preset, ...orderOverrides } = safeOverrides;

    const presetType = _preset || orderOverrides.workshopType || 'tufting';
    const mockOrder = {
        ...buildMockOrderForWorkshop(presetType),
        ...orderOverrides,
    };

    console.log('[ManyChat TEST] Running with mock order:', JSON.stringify(mockOrder), 'allowCreate:', _allowCreate);

    try {
        const result = await runOrderConfirmationManyChat(mockOrder, { allowCreate: _allowCreate });
        console.log('[ManyChat TEST] SUCCESS:', JSON.stringify(result));
        return { success: true, ...result, mockOrder };
    } catch (err) {
        console.error('[ManyChat TEST] FAILED:', err?.message || err);
        return { success: false, error: err?.message || String(err), mockOrder };
    }
}

/** Sandbox: בדיקת הודעת אישור הזמנה — טאפטינג */
export async function testManyChatFlowTufting(overrides) {
    return testManyChatFlow({ ...(overrides || {}), _preset: 'tufting' });
}

/** Sandbox: בדיקת הודעת אישור הזמנה — סדנת נרות */
export async function testManyChatFlowCandles(overrides) {
    return testManyChatFlow({ ...(overrides || {}), _preset: 'candles' });
}

/** Sandbox: בדיקת הודעת אישור הזמנה — סדנת קרמיקה */
export async function testManyChatFlowCeramics(overrides) {
    return testManyChatFlow({ ...(overrides || {}), _preset: 'ceramics' });
}
