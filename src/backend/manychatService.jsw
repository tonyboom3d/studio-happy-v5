/**
 * manychatService.jsw — ManyChat integration for order confirmations and
 * employee/manager notifications.
 *
 * Orders: every paid order goes through the "אישור הזמנה" flow (see data.js).
 * Staff: all employees/managers with a phone receive notifications via the
 * shared staff flow (action_key routing) — see sendStaffManyChat.
 *
 * Never throws out of sendOrderConfirmationManyChat / sendStaffManyChat — a
 * ManyChat failure must never block order creation/payment or backend actions.
 */
import wixSecretsBackend from 'wix-secrets-backend';
import { fetch } from 'wix-fetch';
import { normalizeIsraeliPhone } from 'backend/orderUtils.js';

const MANYCHAT_BASE_URL = 'https://api.manychat.com';
const ISRAEL_TZ = 'Asia/Jerusalem';

// Custom field names — must match ManyChat (see create-manychat-fields.js).
export const MC_FIELDS = {
    workshopType: 'workshop_type',
    organizerName: 'organizer_name',
    organizerPhone: 'organizer_phone',
    organizerEmail: 'organizer_email',
    workshopName: 'workshop_name',
    workshopDate: 'workshop_date',
    workshopTime: 'workshop_time',
    participantsLine: 'participants_line',
    itemCount: 'item_count',
    cupsCount: 'cups_count',
    extraItems: 'extra_items',
    amount: 'amount',
    orderUrl: 'order_url',
    orderNumber: 'order_number',
    participantName: 'participant_name',
    otpCode: 'otp_code',
};

// Custom field created manually in ManyChat (Settings > Custom Fields, type "Text")
// used by the flow's conditions to branch per workshop. Values mirror the
// existing `workshopType` values already used across the codebase.
export const WORKSHOP_CUSTOM_FIELD_NAME = MC_FIELDS.workshopType;

// Routing field for the order-confirmation flow — distinguishes the 3
// workshop-type order-confirmation branches ('order_confirmed', the default)
// from the other customer templates that share the same flow/subscriber
// (sketch_selected, admin_otp_new1). Create manually in ManyChat like action_key.
const NOTIFICATION_TYPE_FIELD = 'notification_type';

// content20260826091942_789880 — shared "אישור הזמנה" flow, branches
// internally per WORKSHOP_CUSTOM_FIELD_NAME condition.
const ORDER_CONFIRMATION_FLOW_NS = 'content20260826091942_789880';

// Shared employee/manager notification flow — branches internally by action_key.
const STAFF_NOTIFICATION_FLOW_NS = 'content20260826132939_659401';

// Custom fields used by the staff/manager flow's routing conditions.
const STAFF_ACTION_KEY_FIELD = 'action_key';
const STAFF_AUDIENCE_FIELD = 'staff_audience';

async function getManyChatApiKey() {
    const apiKey = await wixSecretsBackend.getSecret('manychat_apiKey');
    if (!apiKey) {
        throw new Error('[ManyChat] Missing "manychat_apiKey" in Wix Secrets Manager');
    }
    return apiKey;
}

async function manychatRequest(path, { method = 'GET', query, body } = {}) {
    const apiKey = await getManyChatApiKey();

    let url = `${MANYCHAT_BASE_URL}${path}`;
    if (query) {
        const qs = new URLSearchParams(
            Object.entries(query).filter(([, v]) => v !== undefined && v !== null && v !== '')
        ).toString();
        if (qs) url += `?${qs}`;
    }

    const response = await fetch(url, {
        method,
        headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${apiKey}`,
        },
        body: body ? JSON.stringify(body) : undefined,
    });

    const json = await response.json().catch(() => null);

    if (!response.ok || json?.status === 'error') {
        const detail = json ? JSON.stringify(json) : await response.text().catch(() => '');
        throw new Error(`[ManyChat] ${method} ${path} failed (${response.status}): ${detail}`);
    }

    return json;
}

// --- Subscriber lookup / creation ---

/** ManyChat often stores phone as 972XXXXXXXXX (no +). Try that first. */
function getManyChatPhoneLookupVariants(phone) {
    const e164 = normalizeIsraeliPhone(phone); // +972523813929
    if (!e164) return [];

    const digits = e164.replace(/\D/g, ''); // 972523813929
    const local = digits.startsWith('972') ? '0' + digits.slice(3) : ''; // 0523813929

    return [...new Set([digits, e164, local].filter(Boolean))];
}

/** Canonical format for createSubscriber — digits only, no leading +. */
function formatPhoneForManyChat(phone) {
    const e164 = normalizeIsraeliPhone(phone);
    return e164 ? e164.replace(/^\+/, '') : '';
}

/** GET /fb/subscriber/findBySystemField — query params only, one field at a time. */
async function findSubscriberByField(field, value) {
    if (!value) return null;
    const json = await manychatRequest('/fb/subscriber/findBySystemField', {
        method: 'GET',
        query: { [field]: value },
    });
    // ManyChat returns data: {} (single object) when found, or an empty
    // array/object when nothing matches.
    const data = json?.data;
    if (!data || Array.isArray(data) && data.length === 0) return null;
    if (Array.isArray(data)) return data[0] || null;
    return data.id ? data : null;
}

// ManyChat's findBySystemField only searches the SMS "phone" system field —
// WhatsApp-only subscribers have no "phone" set, only "whatsapp_phone" (which
// ManyChat provides no way to search by directly). The documented workaround
// is a mirror custom field kept in sync with the phone on every find/create,
// searched via findByCustomField. See:
// https://community.manychat.com/general-q-a-43/manychat-api-inconsistency-contact-exists-but-not-found-3503
const WA_PHONE_LOOKUP_FIELD = 'wa_phone_lookup';

let customFieldIdCache = null; // { [fieldName]: fieldId } — cached per warm instance.

async function getCustomFieldsMap() {
    if (customFieldIdCache) return customFieldIdCache;
    const json = await manychatRequest('/fb/page/getCustomFields', { method: 'GET' });
    customFieldIdCache = {};
    for (const f of json?.data || []) {
        if (f?.name) customFieldIdCache[f.name] = f.id;
    }
    return customFieldIdCache;
}

/** Resolves a custom field's numeric id by name, creating it (Text type) if missing. */
async function getOrCreateCustomFieldId(fieldName) {
    const map = await getCustomFieldsMap();
    if (map[fieldName]) return map[fieldName];

    console.log(`[ManyChat] Custom field "${fieldName}" not found — creating it.`);
    const created = await manychatRequest('/fb/page/createCustomField', {
        method: 'POST',
        body: {
            caption: fieldName,
            type: 'text',
            description: 'Auto-created by manychatService.jsw — mirrors the WhatsApp phone so WA-only subscribers can be found via findByCustomField.',
        },
    });
    const id = created?.data?.id;
    if (id) map[fieldName] = id;
    return id || null;
}

/** GET /fb/subscriber/findByCustomField */
async function findSubscriberByCustomField(fieldName, value) {
    if (!value) return null;
    const fieldId = await getOrCreateCustomFieldId(fieldName);
    if (!fieldId) return null;
    const json = await manychatRequest('/fb/subscriber/findByCustomField', {
        method: 'GET',
        query: { field_id: fieldId, field_value: value },
    });
    const data = json?.data;
    if (!Array.isArray(data) || data.length === 0) return null;
    return data[0];
}

/**
 * Looks up an existing subscriber by email first (most reliable), then by
 * phone using multiple format variants (972..., +972..., 05...) against the
 * system "phone" field, then finally via the wa_phone_lookup mirror custom
 * field — needed for WhatsApp-only subscribers the system field can't find.
 */
async function findSubscriber({ email, phone }) {
    if (email) {
        const byEmail = await findSubscriberByField('email', email);
        if (byEmail) return byEmail;
    }
    if (phone) {
        const variants = getManyChatPhoneLookupVariants(phone);
        for (const variant of variants) {
            console.log('[ManyChat] findBySystemField phone try:', variant);
            const byPhone = await findSubscriberByField('phone', variant);
            if (byPhone) {
                console.log('[ManyChat] Subscriber found via phone format:', variant);
                return byPhone;
            }
        }
        const digits = variants.find(v => /^\d+$/.test(v)) || variants[0];
        try {
            const byCustomField = await findSubscriberByCustomField(WA_PHONE_LOOKUP_FIELD, digits);
            if (byCustomField) {
                console.log('[ManyChat] Subscriber found via wa_phone_lookup custom field:', digits);
                return byCustomField;
            }
        } catch (err) {
            console.warn('[ManyChat] findByCustomField(wa_phone_lookup) failed:', err?.message || err);
        }
    }
    return null;
}

/** Best-effort — keeps wa_phone_lookup in sync so this subscriber is always findable next time. */
async function ensureWaPhoneLookupField(subscriberId, phone) {
    const digits = formatPhoneForManyChat(phone);
    if (!subscriberId || !digits) return;
    try {
        await setCustomFieldByName(subscriberId, WA_PHONE_LOOKUP_FIELD, digits);
    } catch (err) {
        console.warn('[ManyChat] ensureWaPhoneLookupField failed. subscriberId:', subscriberId, 'error:', err?.message || err);
    }
}

/**
 * Finds-or-creates a subscriber by email/phone, self-healing the
 * wa_phone_lookup mirror field so future lookups succeed even for
 * WhatsApp-only contacts. Throws a clear, actionable error if ManyChat
 * reports the contact already exists but it still can't be located (a
 * known ManyChat API limitation — see WA_PHONE_LOOKUP_FIELD comment above).
 */
async function findOrCreateSubscriber({ email, phone, firstName, lastName }) {
    let subscriber = await findSubscriber({ email, phone });
    if (subscriber?.id) {
        await ensureWaPhoneLookupField(subscriber.id, phone);
        return subscriber;
    }

    try {
        subscriber = await createSubscriber({ firstName, lastName, phone, email });
    } catch (err) {
        const message = err?.message || String(err);
        if (!/already exists/i.test(message)) throw err;

        console.warn('[ManyChat] createSubscriber said contact already exists but findSubscriber missed it — retrying via wa_phone_lookup:', message);
        subscriber = await findSubscriber({ email, phone });
        if (!subscriber?.id) {
            throw new Error(
                `[ManyChat] Contact with phone ${phone} already exists in ManyChat but cannot be located via the API ` +
                `(known ManyChat limitation for WhatsApp-only contacts with no wa_phone_lookup field set yet). ` +
                `Fix: open the contact in ManyChat and manually add their phone to the "phone" system field, or send ` +
                `them any message once so the flow can set wa_phone_lookup — future sends will then self-heal. Original error: ${message}`
            );
        }
    }

    if (subscriber?.id) {
        await ensureWaPhoneLookupField(subscriber.id, phone);
    }
    return subscriber;
}

function splitName(fullName) {
    const trimmed = String(fullName || '').trim();
    if (!trimmed) return { firstName: '', lastName: '' };
    const parts = trimmed.split(/\s+/);
    return {
        firstName: parts[0],
        lastName: parts.slice(1).join(' ') || '',
    };
}

/** POST /fb/subscriber/createSubscriber */
async function createSubscriber({ firstName, lastName, phone, email }) {
    const mcPhone = formatPhoneForManyChat(phone);
    const json = await manychatRequest('/fb/subscriber/createSubscriber', {
        method: 'POST',
        body: {
            first_name: firstName || undefined,
            last_name: lastName || undefined,
            phone: mcPhone || undefined,
            whatsapp_phone: mcPhone || undefined,
            email: email || undefined,
            has_opt_in_sms: !!mcPhone,
            has_opt_in_email: !!email,
            consent_phrase: 'אישור הזמנת סדנה באתר Studio Happy',
        },
    });
    return json?.data || null;
}

/** POST /fb/subscriber/setCustomFieldByName */
async function setCustomFieldByName(subscriberId, fieldName, fieldValue) {
    return manychatRequest('/fb/subscriber/setCustomFieldByName', {
        method: 'POST',
        body: {
            subscriber_id: subscriberId,
            field_name: fieldName,
            field_value: fieldValue,
        },
    });
}

/** POST /fb/subscriber/setCustomFields — batch update by field_name */
function hasManyChatFieldValue(value) {
    if (value === null || value === undefined) return false;
    if (typeof value === 'string' && value.trim() === '') return false;
    return true;
}

function toManyChatFieldValue(value) {
    // All order-confirmation fields are Text type in ManyChat — must be strings.
    return String(value);
}

async function setCustomFieldsByName(subscriberId, fields) {
    const payload = fields
        .filter(({ name, value }) => !!name && hasManyChatFieldValue(value))
        .map(({ name, value }) => ({
            field_name: name,
            field_value: toManyChatFieldValue(value),
        }));

    if (!payload.length) return;

    try {
        await manychatRequest('/fb/subscriber/setCustomFields', {
            method: 'POST',
            body: {
                subscriber_id: subscriberId,
                fields: payload,
            },
        });
    } catch (err) {
        console.warn('[ManyChat] setCustomFields batch failed, falling back to individual:', err?.message || err);
        for (const { field_name, field_value } of payload) {
            try {
                await setCustomFieldByName(subscriberId, field_name, field_value);
            } catch (fieldErr) {
                console.warn(`[ManyChat] setCustomFieldByName failed for "${field_name}":`, fieldErr?.message || fieldErr);
            }
        }
    }
}

function formatWorkshopDate(dateObj) {
    if (!dateObj) return '';
    const d = new Date(dateObj);
    const parts = new Intl.DateTimeFormat('he-IL', {
        timeZone: ISRAEL_TZ,
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
    }).formatToParts(d);
    const get = (t) => parts.find(p => p.type === t)?.value || '';
    return `${get('weekday')}, ${get('day')} ${get('month')} ${get('year')} בשעה ${get('hour')}:${get('minute')}`;
}

function formatWorkshopTime(dateObj) {
    if (!dateObj) return '';
    const d = new Date(dateObj);
    const parts = new Intl.DateTimeFormat('he-IL', {
        timeZone: ISRAEL_TZ,
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
    }).formatToParts(d);
    const get = (t) => parts.find(p => p.type === t)?.value || '';
    return `${get('hour')}:${get('minute')}`;
}

function workshopTypeLabel(workshopType) {
    if (workshopType === 'candles') return 'סדנת נרות';
    if (workshopType === 'ceramics') return 'סדנת קרמיקה';
    return 'טאפטינג';
}

function buildParticipantsLine(order, workshopType) {
    const adults = order?.adults || 0;
    const children = order?.children || 0;
    if (workshopType === 'ceramics') return String(adults + children);
    return `${adults} מבוגרים${children > 0 ? ` + ${children} ילדים` : ''}`;
}

function buildOrderCustomFields(order, notificationType = 'order_confirmed') {
    const workshopType = order?.workshopType || 'tufting';
    const total = order?.paidTotal || order?.basePrice || 0;
    const cupsCount = Array.isArray(order?.selectedProducts)
        ? order.selectedProducts.reduce((sum, p) => sum + (Number(p.quantity) || 1), 0)
        : 0;
    const extraItems = order?.extraCandleCount || 0;

    const fields = [
        { name: NOTIFICATION_TYPE_FIELD, value: notificationType },
        { name: MC_FIELDS.workshopType, value: workshopType },
        { name: MC_FIELDS.organizerName, value: order?.organizerName },
        { name: MC_FIELDS.organizerPhone, value: order?.organizerPhone },
        { name: MC_FIELDS.organizerEmail, value: order?.organizerEmail },
        { name: MC_FIELDS.workshopName, value: workshopTypeLabel(workshopType) },
        { name: MC_FIELDS.workshopDate, value: formatWorkshopDate(order?.workshopStart) },
        { name: MC_FIELDS.workshopTime, value: formatWorkshopTime(order?.workshopStart) },
        { name: MC_FIELDS.participantsLine, value: buildParticipantsLine(order, workshopType) },
        { name: MC_FIELDS.itemCount, value: order?.rugCount ?? 0 },
        { name: MC_FIELDS.amount, value: total },
    ];

    if (order?.ecomOrderNumber) {
        fields.push({ name: MC_FIELDS.orderNumber, value: order.ecomOrderNumber });
    }

    // The ManyChat template already contains the full base URL
    // (https://www.studiohappy.art/user-selections?admin=) — only the
    // dynamic order id goes into the field, or it gets double-prefixed.
    if (workshopType === 'tufting' && order?._id) {
        fields.push({ name: MC_FIELDS.orderUrl, value: order._id });
    }

    if (workshopType === 'candles' && cupsCount > 0) {
        fields.push({ name: MC_FIELDS.cupsCount, value: cupsCount });
    }

    if (workshopType === 'ceramics' && extraItems > 0) {
        fields.push({ name: MC_FIELDS.extraItems, value: extraItems });
    }

    return fields;
}

async function setOrderCustomFields(subscriberId, order, notificationType = 'order_confirmed') {
    const fields = buildOrderCustomFields(order, notificationType);
    const sending = fields.filter(f => hasManyChatFieldValue(f.value));
    console.log('[ManyChat] setCustomFields:', sending.map(f => `${f.name}=${f.value}`).join(', '));
    await setCustomFieldsByName(subscriberId, fields);
    return sending;
}

// --- Unified send-result logging ---
// Used by every sendXManyChat function so successes/failures are always
// easy to find in the logs and always show what was actually sent.

function formatFieldsForLog(fields) {
    return (fields || [])
        .filter(f => hasManyChatFieldValue(f.value))
        .map(f => `${f.name}=${f.value}`)
        .join(', ') || '(none)';
}

/** Logs a clear success line including every field/value that went into the message. */
function logManyChatSendSuccess(label, { order, phone, subscriberId, notificationType, fields } = {}) {
    console.log(
        `[ManyChat] ✅ ${label} — ההודעה נשלחה בהצלחה | ` +
        `orderId=${order?._id || '(none)'} phone=${phone || order?.organizerPhone || '(none)'} ` +
        `subscriberId=${subscriberId || '(none)'} notificationType=${notificationType || '(none)'} | ` +
        `פרטי ההודעה: ${formatFieldsForLog(fields)}`
    );
}

/** Logs a clear, greppable error line when a message failed to send. */
function logManyChatSendError(label, { order, phone, reason, error } = {}) {
    console.error(
        `[ManyChat] ❌ ${label} — שליחת ההודעה נכשלה! | ` +
        `orderId=${order?._id || '(none)'} phone=${phone || order?.organizerPhone || '(none)'} ` +
        `reason=${reason || 'error'} error=${error || '(none)'}`
    );
}

/** POST /fb/sending/sendFlow */
async function sendFlow(subscriberId, flowNs) {
    return manychatRequest('/fb/sending/sendFlow', {
        method: 'POST',
        body: {
            subscriber_id: subscriberId,
            flow_ns: flowNs,
        },
    });
}

// --- Order confirmation entry point ---

/**
 * Finds-or-creates the ManyChat subscriber for this order's organizer, sets
 * the workshop-routing custom field, and sends the "אישור הזמנה" flow.
 * Throws on failure — used internally by both the production hook (which
 * catches) and the sandbox test helper below (which wants the real error).
 */
async function runOrderConfirmationManyChat(order, { allowCreate = true } = {}) {
    const phone = normalizeIsraeliPhone(order?.organizerPhone);
    const email = order?.organizerEmail || '';
    const workshopType = order?.workshopType || 'tufting';

    if (!phone) {
        throw new Error('[ManyChat] Skipping — no organizerPhone on order');
    }

    let subscriber = await findSubscriber({ email, phone });

    if (!subscriber && allowCreate) {
        const { firstName, lastName } = splitName(order?.organizerName);
        console.log('[ManyChat] Subscriber not found, creating. orderId:', order?._id, 'phone:', phone);
        subscriber = await findOrCreateSubscriber({ email, phone, firstName, lastName });
    } else if (!subscriber) {
        // allowCreate=false (sandbox test with ManyChat import permission not
        // yet approved) — don't hit createSubscriber, fail with a clear hint.
        const tried = getManyChatPhoneLookupVariants(order?.organizerPhone).join(', ') || phone;
        throw new Error(`[ManyChat] No subscriber found for phone variants tried: [${tried}] email=${email || '(none)'}. Create the contact manually in ManyChat first (createSubscriber is skipped), then re-run.`);
    } else {
        console.log('[ManyChat] Subscriber found. orderId:', order?._id, 'subscriberId:', subscriber.id);
        await ensureWaPhoneLookupField(subscriber.id, phone);
    }

    if (!subscriber?.id) {
        throw new Error('[ManyChat] No subscriber id after find/create');
    }

    const sentFields = await setOrderCustomFields(subscriber.id, order);
    await sendFlow(subscriber.id, ORDER_CONFIRMATION_FLOW_NS);

    logManyChatSendSuccess('sendOrderConfirmationManyChat', {
        order, phone, subscriberId: subscriber.id, notificationType: 'order_confirmed', fields: sentFields,
    });
    return { subscriberId: subscriber.id, workshopType };
}

/**
 * Production entry point — called from data.js on every paid order.
 * Never throws — a ManyChat failure must never block the order.
 */
export async function sendOrderConfirmationManyChat(order) {
    try {
        await runOrderConfirmationManyChat(order, { allowCreate: true });
    } catch (err) {
        logManyChatSendError('sendOrderConfirmationManyChat', { order, error: err?.message || String(err) });
    }
}

// --- Sketch-selected notification (replaces Green API sendSelectionNotification) ---

/**
 * Notifies the order's organizer that a participant just picked a sketch.
 * Reuses the order-confirmation subscriber/flow with notification_type
 * 'sketch_selected' — requires a matching branch + the `sketch_selected`
 * template in the ManyChat flow (content20260826091942_789880).
 * Never throws — same contract as sendOrderConfirmationManyChat.
 */
export async function sendSketchSelectedManyChat(order, participantName) {
    try {
        const phone = normalizeIsraeliPhone(order?.organizerPhone);
        const email = order?.organizerEmail || '';
        if (!phone) {
            logManyChatSendError('sendSketchSelectedManyChat', { order, reason: 'no-phone' });
            return { sent: false, reason: 'no-phone' };
        }

        const subscriber = await findSubscriber({ email, phone });
        if (!subscriber?.id) {
            logManyChatSendError('sendSketchSelectedManyChat', { order, phone, reason: 'subscriber-not-found' });
            return { sent: false, reason: 'subscriber-not-found' };
        }

        const sentFields = await setOrderCustomFields(subscriber.id, order, 'sketch_selected');
        const participantField = { name: MC_FIELDS.participantName, value: participantName || 'משתתף' };
        await setCustomFieldsByName(subscriber.id, [participantField]);
        await sendFlow(subscriber.id, ORDER_CONFIRMATION_FLOW_NS);

        logManyChatSendSuccess('sendSketchSelectedManyChat', {
            order, phone, subscriberId: subscriber.id, notificationType: 'sketch_selected',
            fields: [...sentFields, participantField],
        });
        return { sent: true, subscriberId: subscriber.id };
    } catch (err) {
        logManyChatSendError('sendSketchSelectedManyChat', { order, error: err?.message || String(err) });
        return { sent: false, reason: 'error', error: err?.message || String(err) };
    }
}

// --- Dashboard order-status message (replaces Green API custom-message send) ---

/**
 * Sends the fixed "order_dashboard_message" ManyChat template to an
 * arbitrary phone (staff picks the recipient in the dashboard). Meta
 * doesn't allow sending admin-typed free text outside an approved WhatsApp
 * template, so only this one fixed system message is supported — the old
 * CMS-template + free-text compose flow (Green API) is gone.
 * Never throws — same contract as the other ManyChat senders.
 */
export async function sendOrderDashboardMessageManyChat(order, phone) {
    try {
        const targetPhone = normalizeIsraeliPhone(phone || order?.organizerPhone);
        if (!targetPhone) {
            logManyChatSendError('sendOrderDashboardMessageManyChat', { order, phone, reason: 'no-phone' });
            return { sent: false, reason: 'no-phone' };
        }

        const { firstName, lastName } = splitName(order?.organizerName);
        const subscriber = await findOrCreateSubscriber({
            phone: targetPhone, email: order?.organizerEmail, firstName, lastName,
        });
        if (!subscriber?.id) {
            throw new Error('No subscriber id after find/create');
        }

        const sentFields = await setOrderCustomFields(subscriber.id, order, 'order_dashboard_message');
        await sendFlow(subscriber.id, ORDER_CONFIRMATION_FLOW_NS);

        logManyChatSendSuccess('sendOrderDashboardMessageManyChat', {
            order, phone: targetPhone, subscriberId: subscriber.id, notificationType: 'order_dashboard_message', fields: sentFields,
        });
        return { sent: true, subscriberId: subscriber.id };
    } catch (err) {
        logManyChatSendError('sendOrderDashboardMessageManyChat', { order, phone, error: err?.message || String(err) });
        return { sent: false, reason: 'error', error: err?.message || String(err) };
    }
}

// --- Admin OTP notification (replaces Green API OTP send) ---

// Meta template name (resubmitted under a new name after the first
// "admin_otp" submission couldn't be configured) — keep this in sync with
// the AUTHENTICATION template name in Meta Business Manager / ManyChat.
const ADMIN_OTP_NOTIFICATION_TYPE = 'admin_otp_new1';

/**
 * Sends the admin-order-management OTP code to the organizer via ManyChat.
 * Reuses the order-confirmation subscriber/flow with notification_type
 * ADMIN_OTP_NOTIFICATION_TYPE — requires a matching branch + that
 * AUTHENTICATION template in the ManyChat flow (content20260826091942_789880).
 * Never throws — the OTP request itself must not fail if ManyChat is down
 * (the MASTER_OTP fallback in bookingService.web.js still works).
 */
export async function sendAdminOtpManyChat(order, code) {
    try {
        const phone = normalizeIsraeliPhone(order?.organizerPhone);
        const email = order?.organizerEmail || '';
        if (!phone) {
            logManyChatSendError('sendAdminOtpManyChat', { order, reason: 'no-phone' });
            return { sent: false, reason: 'no-phone' };
        }

        const { firstName, lastName } = splitName(order?.organizerName);
        const subscriber = await findOrCreateSubscriber({ email, phone, firstName, lastName });
        if (!subscriber?.id) {
            throw new Error('No subscriber id after find/create');
        }

        const otpFields = [
            { name: NOTIFICATION_TYPE_FIELD, value: ADMIN_OTP_NOTIFICATION_TYPE },
            { name: MC_FIELDS.otpCode, value: code },
        ];
        await setCustomFieldsByName(subscriber.id, otpFields);
        await sendFlow(subscriber.id, ORDER_CONFIRMATION_FLOW_NS);

        logManyChatSendSuccess('sendAdminOtpManyChat', {
            order, phone, subscriberId: subscriber.id, notificationType: ADMIN_OTP_NOTIFICATION_TYPE, fields: otpFields,
        });
        return { sent: true, subscriberId: subscriber.id };
    } catch (err) {
        logManyChatSendError('sendAdminOtpManyChat', { order, error: err?.message || String(err) });
        return { sent: false, reason: 'error', error: err?.message || String(err) };
    }
}

// --- Employee/manager notification flow ---

/** displayName → display_name, hoursWindow → hours_window (matches create-manychat-fields.js). */
function camelToSnake(key) {
    return String(key).replace(/([a-z0-9])([A-Z])/g, '$1_$2').toLowerCase();
}

function buildStaffCustomFields(actionKey, audience, vars) {
    const fields = [
        { name: STAFF_ACTION_KEY_FIELD, value: actionKey },
        { name: STAFF_AUDIENCE_FIELD, value: audience },
    ];
    for (const [key, value] of Object.entries(vars || {})) {
        fields.push({ name: camelToSnake(key), value });
    }
    return fields;
}

/**
 * Sends one employee/manager notification via ManyChat. Mirrors
 * runOrderConfirmationManyChat: find-or-create subscriber by phone, set
 * action_key + staff_audience + every var as a custom field, then send the
 * shared staff-notification flow (branches internally by action_key).
 * Never throws — same contract as sendOrderConfirmationManyChat.
 *
 * @param {string} actionKey - matches EMPLOYEE_ACTION_KEYS in employeeTemplates.js.
 * @param {string} phone
 * @param {'employee'|'manager'} audience
 * @param {object} [vars] - camelCase placeholder vars (e.g. { displayName, date, portalLink }).
 */
export async function sendStaffManyChat(actionKey, phone, audience, vars = {}) {
    try {
        const normalizedPhone = normalizeIsraeliPhone(phone);
        if (!normalizedPhone) {
            logManyChatSendError(`sendStaffManyChat(${actionKey})`, { phone, reason: 'no-phone' });
            return { sent: false, reason: 'no-phone' };
        }

        const subscriber = await findOrCreateSubscriber({ phone: normalizedPhone });
        if (!subscriber?.id) {
            throw new Error('No subscriber id after find/create');
        }

        const fields = buildStaffCustomFields(actionKey, audience, vars);
        await setCustomFieldsByName(subscriber.id, fields);
        await sendFlow(subscriber.id, STAFF_NOTIFICATION_FLOW_NS);

        logManyChatSendSuccess(`sendStaffManyChat(${actionKey})`, {
            phone: normalizedPhone, subscriberId: subscriber.id, notificationType: actionKey, fields,
        });
        return { sent: true, subscriberId: subscriber.id };
    } catch (err) {
        logManyChatSendError(`sendStaffManyChat(${actionKey})`, { phone, error: err?.message || String(err) });
        return { sent: false, reason: 'error', error: err?.message || String(err) };
    }
}

// --- Sandbox test helpers ---
//
// Run ▶ directly from the Velo Editor (pass JSON as the single argument):
//   testStaffManyChat({ "actionKey": "employee_shift_assigned", ... })
//   testStaffManyChatShiftAssigned()  — preset for shift-assigned test
//
// Order confirmation tests:
//   testManyChatFlowTufting()   — אישור הזמנה לטאפטינג
//   testManyChatFlowCandles()   — אישור הזמנה לסדנת נרות
//   testManyChatFlowCeramics()  — אישור הזמנה לסדנת קרמיקה
//
// Or testManyChatFlow({ "workshopType": "candles", ... }) for custom overrides.
// ManyChat import permission is approved, so createSubscriber is tested by
// default (_allowCreate: true). Pass { "_allowCreate": false } to only
// exercise the find path against an already-existing contact.

function buildMockOrderForWorkshop(workshopType) {
    const workshopStart = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString();
    const base = {
        _id: `sandbox-test-${workshopType}-${Date.now()}`,
        organizerName: 'בדיקת מנצ׳אט',
        organizerPhone: '0523813929',
        organizerEmail: 'test@studiohappy.art',
        workshopType,
        workshopStart,
        adults: 2,
        basePrice: 450,
        paidTotal: 450,
    };

    if (workshopType === 'candles') {
        return {
            ...base,
            children: 1,
            rugCount: 4,
            selectedProducts: [{ quantity: 2 }, { quantity: 1 }],
        };
    }

    if (workshopType === 'ceramics') {
        return {
            ...base,
            children: 0,
            rugCount: 2,
            extraCandleCount: 1,
        };
    }

    // tufting (default)
    return {
        ...base,
        children: 1,
        rugCount: 3,
    };
}

/** Sandbox: test one employee/manager ManyChat notification — pass a single JSON object. */
export async function testStaffManyChat(payload) {
    const p = payload && typeof payload === 'object' ? payload : {};
    const actionKey = p.actionKey || 'employee_shift_assigned';
    const phone = p.phone || '0523813929';
    const audience = p.audience || 'employee';
    const vars = p.vars && typeof p.vars === 'object' ? p.vars : {};

    console.log('[ManyChat staff TEST]', JSON.stringify({ actionKey, phone, audience, vars }));

    const result = await sendStaffManyChat(actionKey, phone, audience, vars);
    console.log('[ManyChat staff TEST] result:', JSON.stringify(result));
    return { success: !!result.sent, ...result, actionKey, phone, audience, vars };
}

/** Sandbox preset — employee_shift_assigned to 0523813929 */
export async function testStaffManyChatShiftAssigned(overrides) {
    const o = overrides && typeof overrides === 'object' ? overrides : {};
    return testStaffManyChat({
        actionKey: 'employee_shift_assigned',
        phone: '0523813929',
        audience: 'employee',
        vars: {
            displayName: 'טוני',
            detail: 'טאפטינג ',
            dow: 'שני',
            date: '01.09.2026',
            portalLink: 'test-link',
            ...(o.vars || {}),
        },
    });
}

export async function testManyChatFlow(overrides) {
    const safeOverrides = overrides && typeof overrides === 'object' ? overrides : {};
    const { _allowCreate = true, _preset, ...orderOverrides } = safeOverrides;

    const presetType = _preset || orderOverrides.workshopType || 'tufting';
    const mockOrder = {
        ...buildMockOrderForWorkshop(presetType),
        ...orderOverrides,
    };

    console.log('[ManyChat TEST] Running with mock order:', JSON.stringify(mockOrder), 'allowCreate:', _allowCreate);

    try {
        const result = await runOrderConfirmationManyChat(mockOrder, { allowCreate: _allowCreate });
        console.log('[ManyChat TEST] SUCCESS:', JSON.stringify(result));
        return { success: true, ...result, mockOrder };
    } catch (err) {
        console.error('[ManyChat TEST] FAILED:', err?.message || err);
        return { success: false, error: err?.message || String(err), mockOrder };
    }
}

/** Sandbox: בדיקת הודעת אישור הזמנה — טאפטינג */
export async function testManyChatFlowTufting(overrides) {
    return testManyChatFlow({ ...(overrides || {}), _preset: 'tufting' });
}

/** Sandbox: בדיקת הודעת אישור הזמנה — סדנת נרות */
export async function testManyChatFlowCandles(overrides) {
    return testManyChatFlow({ ...(overrides || {}), _preset: 'candles' });
}

/** Sandbox: בדיקת הודעת אישור הזמנה — סדנת קרמיקה */
export async function testManyChatFlowCeramics(overrides) {
    return testManyChatFlow({ ...(overrides || {}), _preset: 'ceramics' });
}
