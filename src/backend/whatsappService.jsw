import wixSecretsBackend from 'wix-secrets-backend';
import { fetch } from 'wix-fetch';

const ISRAEL_TZ = 'Asia/Jerusalem';

// Candles Workshop ("סדנת נרות") Service IDs — keep in sync with bookingService.web.js.
const CANDLES_SERVICE_ID_SET = new Set([
    'eb8fec0e-5d04-48a3-a795-e3e8051d07da',
    'f0f6e447-02d8-4808-80ba-3c380ce9eae8',
]);

/** True if the order belongs to the candles ("סדנת נרות") workshop. */
function isCandlesOrder(order) {
    if (order?.workshopType) return order.workshopType === 'candles';
    return !!order?.serviceId && CANDLES_SERVICE_ID_SET.has(order.serviceId);
}

// Ceramics Workshop ("סדנת קרמיקה") Service IDs — keep in sync with bookingService.web.js.
const CERAMICS_SERVICE_ID_SET = new Set([
    'ad89914a-1845-48c6-804d-544cd17f179b',
    '06508cd0-92ec-49d9-bd27-a3d4999afc89',
]);

/** True if the order belongs to the ceramics ("סדנת קרמיקה") workshop. */
function isCeramicsOrder(order) {
    if (order?.workshopType) return order.workshopType === 'ceramics';
    return !!order?.serviceId && CERAMICS_SERVICE_ID_SET.has(order.serviceId);
}

// --- Green API credentials ---

async function getGreenApiCredentials() {
    const idInstance = await wixSecretsBackend.getSecret('green_idInstance');
    const apiToken = await wixSecretsBackend.getSecret('green_apiTokenInstance');
    return { idInstance, apiToken };
}

// --- Core send function ---

export async function sendGreenApiWhatsApp(phone, message) {
    console.log('[GreenAPI] sendGreenApiWhatsApp — raw phone input:', phone);

    let idInstance, apiToken;
    try {
        ({ idInstance, apiToken } = await getGreenApiCredentials());
        console.log('[GreenAPI] credentials fetched — idInstance:', idInstance ? idInstance.slice(0, 6) + '…' : 'MISSING', 'apiToken:', apiToken ? '***' : 'MISSING');
    } catch (credErr) {
        console.error('[GreenAPI] failed to fetch credentials:', credErr?.message || credErr);
        throw credErr;
    }

    if (!idInstance || !apiToken) {
        throw new Error('[GreenAPI] Missing idInstance or apiToken in Wix Secrets');
    }

    let digits = String(phone).replace(/\D/g, '');
    if (digits.startsWith('0')) digits = '972' + digits.slice(1);
    if (!digits.startsWith('972')) digits = '972' + digits;
    const chatId = `${digits}@c.us`;
    console.log('[GreenAPI] resolved chatId:', chatId);

    const url = `https://api.green-api.com/waInstance${idInstance}/sendMessage/${apiToken}`;
    console.log('[GreenAPI] POST to URL (token hidden):', url.replace(apiToken, '***'));

    let response;
    try {
        response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ chatId, message }),
        });
    } catch (fetchErr) {
        console.error('[GreenAPI] fetch threw:', fetchErr?.message || fetchErr);
        throw fetchErr;
    }

    console.log('[GreenAPI] response status:', response.status, response.statusText);

    if (!response.ok) {
        const text = await response.text();
        console.error('[GreenAPI] error body:', text);
        throw new Error(`Green API error ${response.status}: ${text}`);
    }

    const json = await response.json();
    console.log('[GreenAPI] success response:', JSON.stringify(json));
    return json;
}

// --- Date formatting ---

function formatWorkshopDate(dateObj) {
    if (!dateObj) return '';
    const d = new Date(dateObj);
    const parts = new Intl.DateTimeFormat('he-IL', {
        timeZone: ISRAEL_TZ,
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
    }).formatToParts(d);
    const get = (t) => parts.find(p => p.type === t)?.value || '';
    return `${get('weekday')}, ${get('day')} ${get('month')} ${get('year')} בשעה ${get('hour')}:${get('minute')}`;
}

// --- Order confirmation ---

export async function sendOrderConfirmationWhatsApp(order) {
    console.log('[sendOrderConfirmationWhatsApp] called — orderId:', order?._id, 'phone:', order?.organizerPhone || 'MISSING');
    if (!order?.organizerPhone) {
        console.warn('[sendOrderConfirmationWhatsApp] aborting — no organizerPhone on order');
        return;
    }

    if (isCandlesOrder(order)) {
        await sendCandlesOrderConfirmationWhatsApp(order);
        return;
    }

    if (isCeramicsOrder(order)) {
        await sendCeramicsOrderConfirmationWhatsApp(order);
        return;
    }

    const adminLink = `https://www.studiohappy.art/user-selections?admin=${order._id}`;
    const dateStr = formatWorkshopDate(order.workshopStart);

    const msg = [
        `🎉 *ההזמנה בוצעה בהצלחה!*`,
        ``,
        `👤 *שם המזמין:* ${order.organizerName || ''}`,
        `📞 *טלפון:* ${order.organizerPhone || ''}`,
        `📧 *מייל:* ${order.organizerEmail || ''}`,
        ``,
        `📅 *מועד הסדנה:* ${dateStr}`,
        `📍 *מיקום:* סטודיו האפי, הדובדבן 7, קריית אונו (קומה 5)`,
        ``,
        `👥 *משתתפים:* ${order.adults || 0} מבוגרים${order.children > 0 ? ` + ${order.children} ילדים` : ''}`,
        `🧶 *שטיחים:* ${order.rugCount || 0}`,
        `💰 *סה"כ שולם:* ₪${order.basePrice || 0}`,
        ``,
        `🔗 *קישור ניהול ההזמנה - *חשוב!* אין להעביר את הקישור לחברי הקבוצה - דרך הקישור תוכלו לבחור סקיצות, ליצור קבוצות ולנהל את ההזמנה.`,
        adminLink,
        ``,
        `יש שאלות? שלחו לנו הודעה 💬`,
        `בהצלחה וכיף! 🎨`
    ].join('\n');

    await sendGreenApiWhatsApp(order.organizerPhone, msg);
    console.log('[sendOrderConfirmationWhatsApp] Sent to', order.organizerPhone);
}

/** Candles ("סדנת נרות") order confirmation — summary only, no sketch/admin link. */
async function sendCandlesOrderConfirmationWhatsApp(order) {
    const dateStr = formatWorkshopDate(order.workshopStart);
    const total = order.paidTotal || order.basePrice || 0;
    const cupsCount = Array.isArray(order.selectedProducts)
        ? order.selectedProducts.reduce((sum, p) => sum + (Number(p.quantity) || 1), 0)
        : 0;

    const msg = [
        `🕯️ *ההזמנה לסדנת נרות בוצעה בהצלחה!*`,
        ``,
        `👤 *שם המזמין:* ${order.organizerName || ''}`,
        `📞 *טלפון:* ${order.organizerPhone || ''}`,
        `📧 *מייל:* ${order.organizerEmail || ''}`,
        ``,
        `📅 *מועד הסדנה:* ${dateStr}`,
        `📍 *מיקום:* סטודיו האפי, הדובדבן 7, קריית אונו (קומה 5)`,
        ``,
        `👥 *משתתפים:* ${order.adults || 0} מבוגרים${order.children > 0 ? ` + ${order.children} ילדים` : ''}`,
        `🕯️ *נרות:* ${order.rugCount || 0}`,
        cupsCount > 0 ? `🥤 *כוסות שנבחרו:* ${cupsCount}` : null,
        `💰 *סה"כ שולם:* ₪${total}`,
        ``,
        `יש שאלות? שלחו לנו הודעה 💬`,
        `בהצלחה וכיף! 🕯️`
    ].filter(Boolean).join('\n');

    await sendGreenApiWhatsApp(order.organizerPhone, msg);
    console.log('[sendCandlesOrderConfirmationWhatsApp] Sent to', order.organizerPhone);
}

/** Ceramics ("סדנת קרמיקה") order confirmation — summary only, no sketch/admin link. */
async function sendCeramicsOrderConfirmationWhatsApp(order) {
    const dateStr = formatWorkshopDate(order.workshopStart);
    const total = order.paidTotal || order.basePrice || 0;
    const participants = order.adults || 0;
    const extraItems = order.extraCandleCount || 0;
    const itemsCount = order.rugCount || 0;

    const msg = [
        `🏺 *ההזמנה לסדנת קרמיקה בוצעה בהצלחה!*`,
        ``,
        `👤 *שם המזמין:* ${order.organizerName || ''}`,
        `📞 *טלפון:* ${order.organizerPhone || ''}`,
        `📧 *מייל:* ${order.organizerEmail || ''}`,
        ``,
        `📅 *מועד הסדנה:* ${dateStr}`,
        `📍 *מיקום:* סטודיו האפי, הדובדבן 7, קריית אונו (קומה 5)`,
        ``,
        `👥 *משתתפים:* ${participants}`,
        `🏺 *כלים:* ${itemsCount}`,
        extraItems > 0 ? `✨ *כלים נוספים:* ${extraItems}` : null,
        `💰 *סה"כ שולם:* ₪${total}`,
        ``,
        `יש שאלות? שלחו לנו הודעה 💬`,
        `בהצלחה וכיף! 🏺`
    ].filter(Boolean).join('\n');

    await sendGreenApiWhatsApp(order.organizerPhone, msg);
    console.log('[sendCeramicsOrderConfirmationWhatsApp] Sent to', order.organizerPhone);
}

// --- Selection notification (when participant completes a sketch pick) ---

export async function sendSelectionNotification(order, participantName) {
    if (!order?.organizerPhone || !order?.notifyOnSelection) return;

    const adminLink = `https://www.studiohappy.art/user-selections?admin=${order._id}`;
    const displayName = participantName || 'משתתף';
    const msg = [
        `היי! ${displayName} בדיוק בחר/ה סקיצה לסדנה הקרובה 🎨`,
        ``,
        `לצפייה בבחירה או לכיבוי התראות, היכנסו לקישור הניהול:`,
        adminLink,
    ].join('\n');

    await sendGreenApiWhatsApp(order.organizerPhone, msg);
    console.log(`[sendSelectionNotification] Sent for participant: ${displayName}`);
}
